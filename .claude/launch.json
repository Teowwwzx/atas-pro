{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && node node_modules/next/dist/bin/next dev"],
      "port": 3000
    },
    {
      "name": "fastapi-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/run.py"],
      "port": 8000
    },
    {
      "name": "docker-infra",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "postgres", "redis", "rabbitmq"],
      "port": 15672
    },
    {
      "name": "docker-full-stack",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 8000
    },
    {
      "name": "celery-worker",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && celery -A app.core.celery_app.celery_app worker -l info --concurrency=2"],
      "port": 5555
    }
  ]
}
